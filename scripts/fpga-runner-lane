#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}"
LOCK_PATH="${FPGA_LANE_LOCK:-$LOCK_DIR/fpga-lisp-com4.lock}"
WAIT_SECONDS="${FPGA_LANE_WAIT_SECONDS:-120}"
CLIENT="${FPGA_LANE_CLIENT:-$SCRIPT_DIR/fpga_runner_lane.py}"

mkdir -p "$(dirname "$LOCK_PATH")"
exec 9>"$LOCK_PATH"
if ! flock -w "$WAIT_SECONDS" 9; then
  echo "FPGA_LANE_BUSY lock=$LOCK_PATH wait_seconds=$WAIT_SECONDS" >&2
  exit 75
fi

if [[ ! -f "$CLIENT" ]]; then
  echo "FPGA_LANE_NO_CLIENT path=$CLIENT" >&2
  exit 69
fi

exec python3 "$CLIENT" "$@"
